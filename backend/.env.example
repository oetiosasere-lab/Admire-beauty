# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (separate with comma if multiple)
CORS_ORIGIN=http://localhost:5173,https://admirebeauty.vercel.app

# Supabase Credentials (Render Environment Variables)
# NOTE: The service role key must NEVER be exposed to the frontend!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Admin Setup
ADMIN_EMAIL=admin@admirebeauty.com
