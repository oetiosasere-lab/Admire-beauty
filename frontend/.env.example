# Vercel Frontend Environment Variables
# In production, set to your Render backend URL (e.g. https://admire-beauty-api.onrender.com)
VITE_API_BASE_URL=http://localhost:5000/api

# Optional Public Supabase Anon Key (for client-side auth directly if desired)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
